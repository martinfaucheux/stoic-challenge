# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_security

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Configuration
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback/google

# Application Configuration
BASE_URL=http://localhost:8000

# Encryption Key for Token Storage (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-encryption-key-here

# Gmail API Settings (for legacy single-user mode)
GMAIL_CREDENTIALS_FILE=services/gmail/credentials.json
GMAIL_TOKEN_FILE=services/gmail/token.json
MAX_EMAILS_TO_FETCH=10
